{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "api/index.js"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/contact(.*)",
      "destination": {
        "service": "frontend",
        "path": "/contact/index.html"
      }
    },
    {
      "source": "/about(.*)",
      "destination": {
        "service": "frontend",
        "path": "/about/index.html"
      }
    },
    {
      "source": "/sales(.*)",
      "destination": {
        "service": "frontend",
        "path": "/sales/index.html"
      }
    },
    {
      "source": "/sale(.*)",
      "destination": {
        "service": "frontend",
        "path": "/sale/index.html"
      }
    },
    {
      "source": "/new-arrivals(.*)",
      "destination": {
        "service": "frontend",
        "path": "/new-arrivals/index.html"
      }
    },
    {
      "source": "/newarrivals(.*)",
      "destination": {
        "service": "frontend",
        "path": "/newarrivals/index.html"
      }
    },
    {
      "source": "/categories(.*)",
      "destination": {
        "service": "frontend",
        "path": "/categories/index.html"
      }
    },
    {
      "source": "/stitched(.*)",
      "destination": {
        "service": "frontend",
        "path": "/stitched/index.html"
      }
    },
    {
      "source": "/stitch(.*)",
      "destination": {
        "service": "frontend",
        "path": "/stitch/index.html"
      }
    },
    {
      "source": "/unstitched(.*)",
      "destination": {
        "service": "frontend",
        "path": "/unstitched/index.html"
      }
    },
    {
      "source": "/baby-clothes(.*)",
      "destination": {
        "service": "frontend",
        "path": "/baby-clothes/index.html"
      }
    },
    {
      "source": "/babies(.*)",
      "destination": {
        "service": "frontend",
        "path": "/babies/index.html"
      }
    },
    {
      "source": "/kids(.*)",
      "destination": {
        "service": "frontend",
        "path": "/kids/index.html"
      }
    },
    {
      "source": "/baby(.*)",
      "destination": {
        "service": "frontend",
        "path": "/baby/index.html"
      }
    },
    {
      "source": "/quick-view/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/quick-view/index.html"
      }
    },
    {
      "source": "/quickview/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/quickview/index.html"
      }
    },
    {
      "source": "/product/(.*)",
      "destination": {
        "service": "frontend",
        "path": "/product/index.html"
      }
    },
    {
      "source": "/cart(.*)",
      "destination": {
        "service": "frontend",
        "path": "/cart/index.html"
      }
    },
    {
      "source": "/wishlist(.*)",
      "destination": {
        "service": "frontend",
        "path": "/wishlist/index.html"
      }
    },
    {
      "source": "/checkout(.*)",
      "destination": {
        "service": "frontend",
        "path": "/checkout/index.html"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
