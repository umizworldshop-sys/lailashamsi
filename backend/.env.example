# ========================================================
# UMI'Z WORLD ATELIER - BACKEND ENVIRONMENT EXAMPLE
# ========================================================

# Server Port (Local standalone only - Vercel manages this automatically)
PORT=5000

# Environment Mode
NODE_ENV=production

# MongoDB Atlas Production Connection URI
# Ensure IP 0.0.0.0/0 (Anywhere) is allowed in Atlas Network Access
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lailashamsi?retryWrites=true&w=majority

# JWT Authentication Secret Key (Minimum 32 characters secure string)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Cloudinary Image Storage & CDN
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Production Frontend URL (Permits CORS for custom domains; all .vercel.app domains are automatically allowed)
FRONTEND_URL=https://your-frontend-project.vercel.app
